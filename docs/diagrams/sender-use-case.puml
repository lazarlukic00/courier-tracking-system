@startuml sender-use-case
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F5F7FA
  BorderColor #2F4A6D
}

actor "Sender" as S

rectangle "Courier Tracking System" {
  usecase "Register" as UC1
  usecase "Log in" as UC2
  usecase "Create shipment" as UC3
  usecase "View shipments" as UC4
  usecase "Filter shipments\nby period" as UC5
  usecase "View shipment\nhistory" as UC6
  usecase "Cancel shipment" as UC7
}

S --> UC1
S --> UC2
S --> UC3
S --> UC4

UC5 .> UC4 : <<extend>>
UC6 .> UC4 : <<extend>>
UC7 .> UC6 : <<extend>>
@enduml