@startuml posiljalac-use-case
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F5F7FA
  BorderColor #2F4A6D
}

actor "Pošiljalac" as P

rectangle "Courier Tracking System" {
  usecase "Registracija" as UC1
  usecase "Prijava" as UC2
  usecase "Kreiranje pošiljke" as UC3
  usecase "Pregled pošiljki" as UC4
  usecase "Filtriranje pošiljki\npo periodu" as UC5
  usecase "Pregled istorije\npošiljke" as UC6
  usecase "Otkazivanje pošiljke" as UC7
}

P --> UC1
P --> UC2
P --> UC3
P --> UC4

UC5 .> UC4 : <<extend>>
UC6 .> UC4 : <<extend>>
UC7 .> UC6 : <<extend>>
@enduml